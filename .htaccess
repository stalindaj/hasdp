# The repo lives inside public_html on the host, so without this the main
# domain could serve any file in it — including civhr/.env (DB password).
# Deny everything here; civhr/public/.htaccess re-grants access for the
# subdomain, whose document root points there.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
